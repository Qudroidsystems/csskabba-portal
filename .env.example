APP_NAME="Smart Hotel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos
APP_URL=http://localhost/hotel/public

# Hotel branding (logo paths are relative to /public)
HOTEL_NAME="Smart Hotel"
HOTEL_TAGLINE="Hotel Management & Security Platform"
#HOTEL_LOGO=images/hotel-logo.png
#HOTEL_LOGO_LIGHT=images/hotel-logo-light.png
#HOTEL_FAVICON=images/favicon.png

# Guest bill taxes (percent; 0 = off). Prices include tax unless set to false.
HOTEL_PRICES_INCLUDE_TAX=true
HOTEL_VAT_RATE=7.5
HOTEL_SERVICE_CHARGE_RATE=0
HOTEL_CONSUMPTION_TAX_RATE=0

# Audit trail: flag voids/refunds/discounts at or above this amount, and this many failed sign-ins or scans in 15 minutes
HOTEL_AUDIT_FLAG_AMOUNT=50000
HOTEL_AUDIT_FLAG_FAILURES=5
# Cashier shifts: a cash count off by more than this needs a note
HOTEL_CASH_VARIANCE_TOLERANCE=100
# Housekeeping: a cleaned room needs a supervisor's inspection before it goes back on sale
HOTEL_HOUSEKEEPING_INSPECTION=true
HOTEL_VISITOR_PASS_HOURS=4
HOTEL_VISITOR_RETENTION_DAYS=180
HOTEL_LOST_ITEM_DAYS=90

# First Super Admin account (used by `php artisan db:seed`)
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@smarthotel.com
ADMIN_PASSWORD=ChangeMe@123

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_hotel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@smarthotel.com"
MAIL_FROM_NAME="${HOTEL_NAME}"
